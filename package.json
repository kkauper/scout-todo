    "@pinia/nuxt": "^1.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "fuse.js": "^7.5.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pinia": "^4.0.3",
    "postgres": "^3.4.9",
    "reka-ui": "^2.10.5",
    "shadcn-nuxt": "^2.8.2",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
