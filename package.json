{
  "name": "scout",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "user:add": "tsx scripts/user.ts add",
    "user:passwd": "tsx scripts/user.ts passwd",
    "build:cf": "NITRO_PRESET=cloudflare_module nuxt build",
    "preview:cf": "pnpm run build:cf && wrangler dev",
    "deploy": "pnpm run build:cf && wrangler deploy",
    "cf:types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run --config vitest.integration.config.ts",
    "typecheck": "nuxi typecheck",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
